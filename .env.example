EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_BACKEND_MODE=mock
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_APP_CHECK_DEBUG=false
# Development only: point the app at local Firebase emulators (e.g. 127.0.0.1). Ignored in production.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# EXPO_PUBLIC_APP_ENV supports development, staging, or production.
# EXPO_PUBLIC_* values are bundled into the client and must never contain secrets.
# Firebase configuration and server-side credentials are intentionally not included in Phase 2.
